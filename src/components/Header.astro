---
import Container from "./Container.astro";
---

<header class="sticky top-0 z-50 border-b border-border bg-white/90 backdrop-blur-md">
  <Container class="flex items-center justify-between py-3">
    <!-- No compact logo exists yet; the symbol alone stands in for it next to the name. -->
    <a href="/" class="flex items-center gap-3 text-xl font-bold text-primary">
      <img src="/icon.png" alt="" width="40" height="40" class="size-10" />
      <span>ICT Pathfinder</span>
    </a>
    <a
      href="https://github.com/ictpathfinder"
      class="flex items-center gap-2 rounded-(--radius) bg-black px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-black/80"
    >
      <!-- The visible text names the link; the mark is decoration. -->
      <img
        src="/github-mark-white.svg"
        alt=""
        width="16"
        height="16"
        class="size-4"
      />
      GitHub
    </a>
  </Container>
</header>
